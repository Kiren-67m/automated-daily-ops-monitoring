        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ handoff_status: 'escalate', summary: 'Escalate ' + $json.escalation_event_ids.length + ' unclaimed high-severity or overdue incident(s): ' + $json.escalation_event_ids.join(', ') }) }}",
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1200,
