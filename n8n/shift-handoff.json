    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "AutoQueueN8nDemo"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        240,
        0
      ],
      "id": "66845579-802c-5640-97b1-ba9a4f8a7f5a",
      "name": "Read incident queue"
    },
    {
      "parameters": {
        "jsCode": "const { incidents } = $input.first().json;\nconst now = new Date();\nconst pending = incidents.map(incident => ({\n  ...incident,\n  age_hours: Math.max(0, Math.floor((now - new Date(incident.created_at)) / 3600000)),\n  next_action: incident.status === 'open' ? 'Assign an operator' : 'Follow up with the assigned operator',\n})).sort((a, b) => {\n  const priority = Number(b.severity === 'high') - Number(a.severity === 'high');\n  return priority || a.created_at.localeCompare(b.created_at);\n});\nreturn [{ json: {\n  generated_at: now.toISOString(),\n  active_count: pending.length,\n  open_count: pending.filter(incident => incident.status === 'open').length,\n  acknowledged_count: pending.filter(incident => incident.status === 'acknowledged').length,\n  high_priority_count: pending.filter(incident => incident.severity === 'high').length,\n  older_than_24h_count: pending.filter(incident => incident.age_hours >= 24).length,\n  priority_queue: pending,\n  escalation_event_ids: pending.filter(incident =>\n    incident.age_hours >= 24 || (incident.severity === 'high' && incident.status === 'open')\n  ).map(incident => incident.event_id),\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "0d0d46f0-5eb9-5d86-bf4a-f5b41f9d68b9",
      "name": "Rank incidents and count workload"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "736ad2f8-4baf-53ef-bf6f-d8cc4885e616",
              "leftValue": "={{ $json.active_count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        0
      ],
      "id": "79d36ae0-3b01-587c-8fca-727d6ca55f28",
      "name": "Any active incidents?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "6050b672-c906-5cef-881c-ee451d5e94eb",
              "leftValue": "={{ $json.escalation_event_ids.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
