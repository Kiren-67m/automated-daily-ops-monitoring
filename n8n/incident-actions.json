    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst eventId = typeof body.event_id === 'string' ? body.event_id.trim() : '';\nconst operator = typeof body.operator === 'string' ? body.operator.trim() : '';\nconst note = typeof body.note === 'string' ? body.note.trim() : '';\nconst acknowledge = body.action === 'acknowledge';\nconst resolve = body.action === 'resolve';\n\nif (!/^daily-ops:\\d{4}-\\d{2}-\\d{2}$/.test(eventId) || !operator || operator.length > 120\n    || (!acknowledge && !resolve) || (resolve && !note) || note.length > 2000) {\n  return [{ json: { valid: false, error: 'Provide an event ID, action and operator. Resolve also requires a note.' } }];\n}\n\nconst now = new Date().toISOString();\nconst changes = acknowledge\n  ? { status: 'acknowledged', acknowledged_by: operator, acknowledged_at: now }\n  : { status: 'resolved', resolved_by: operator, resolved_at: now, resolution_note: note };\n\nreturn [{ json: { valid: true, event_id: eventId, action: body.action, changes } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
